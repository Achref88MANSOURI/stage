# SOC-3s agent-service — configuration reference
#
# Copy to .env and fill in real values. Never commit .env — it holds live
# TheHive / iTop / Elasticsearch credentials.
#
# config.py loads every variable below at import time and raises immediately on
# any missing REQUIRED variable (architecture §19). Variables marked OPTIONAL
# have the documented default shown and may be omitted.

# ---------------------------------------------------------------------------
# LLM — exactly two single-shot calls per alert, no tools on either.
# Stage 3 (nodes/context.py) uses LLM_*; Stage 4 (nodes/analyze.py) uses
# LLM_ANALYZE_*. Architecture §19 specifies qwen3.5:4b for Stage 3, but this
# deployment runs foundation-sec-reasoning for BOTH stages by decision — see
# CLAUDE.md "Deployment-specific decisions".
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://172.20.24.225:11434/v1        # REQUIRED
LLM_MODEL=foundation-sec-reasoning:latest         # REQUIRED
LLM_API_KEY=sk-no-auth                            # REQUIRED (Ollama ignores it)
LLM_ANALYZE_BASE_URL=http://172.20.24.225:11434/v1  # REQUIRED
LLM_ANALYZE_MODEL=foundation-sec-reasoning:latest   # REQUIRED
LLM_ANALYZE_API_KEY=sk-no-auth                      # REQUIRED

# ---------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------
THEHIVE_URL=http://172.20.24.221:9000             # REQUIRED
THEHIVE_API_KEY=                                  # REQUIRED

ITOP_URL=http://172.20.24.220:8080                # REQUIRED
ITOP_USER=                                        # REQUIRED
ITOP_PWD=                                         # REQUIRED (iTop REST auth_pwd)

# The :9200 port is mandatory. The bare host redirects (302) to the SOC web UI.
ES_URL=https://172.20.24.58:9200                  # REQUIRED
ES_API_KEY=                                       # REQUIRED (sent as "Authorization: ApiKey <value>")

QDRANT_URL=http://172.20.24.224:6333              # REQUIRED
QDRANT_EMBEDDING_MODEL=BAAI/bge-m3                # OPTIONAL, default BAAI/bge-m3
# BAAI/bge-m3 above runs behind its own HTTP microservice, not in-process.
EMBEDDING_API_URL=http://172.20.24.224:8001       # REQUIRED

# Cortex is NOT configured and NOT called by this service (architecture §6, §13).
# Analyzer reports arrive pre-computed on the TheHive alert.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# NOTE: architecture §19 names this FP_DB_PATH; this deployment standardised on
# FP_TRACKING_DB_PATH, which is what config.py reads.
FP_TRACKING_DB_PATH=./data/fp_events.db           # OPTIONAL, default ./data/fp_events.db

# Redis is optional by design — absence disables Stage 0 dedup and NEVER blocks
# the pipeline (architecture §5). Not deployed in this environment.
# REDIS_URL=redis://localhost:6379                # OPTIONAL, no default

# ---------------------------------------------------------------------------
# Timeouts (seconds) — Stage 1 per-tool budgets, architecture §6 / §19
# ---------------------------------------------------------------------------
STAGE_1_TOOL_TIMEOUT_ITOP=5                       # OPTIONAL, default 5
STAGE_1_TOOL_TIMEOUT_THEHIVE=5                    # OPTIONAL, default 5
STAGE_1_TOOL_TIMEOUT_ES=3                         # OPTIONAL, default 3
STAGE_1_TOOL_TIMEOUT_QDRANT=3                     # OPTIONAL, default 3
STAGE_3_LLM_TIMEOUT=120                           # OPTIONAL, default 120. This deployment's
                                                   # actual .env sets 600 — a real live Stage 3
                                                   # call (real EnrichedEvidence, CPU inference)
                                                   # took 271s end-to-end. See CLAUDE.md
                                                   # "Deployment-specific decisions".
STAGE_4_LLM_TIMEOUT=180                           # OPTIONAL, default 180

# ---------------------------------------------------------------------------
# Scoring weights and modifier bounds — architecture §10 / §19.
# These are educated starting values, expected to be tuned over 30-60 days
# against analyst feedback (architecture §17).
# ---------------------------------------------------------------------------
WEIGHT_LIKELIHOOD=0.40                            # OPTIONAL, default 0.40
WEIGHT_IMPACT=0.35                                # OPTIONAL, default 0.35
WEIGHT_CONFIDENCE=0.25                            # OPTIONAL, default 0.25
WEIGHT_LLM_CRITICALITY=0.15                       # OPTIONAL, default 0.15. Stage 3's
                                                   # llm_criticality_score (0-100), normalized
                                                   # to 0-1, augments the three weights above —
                                                   # not yet wired into scoring.py (Step 7, not
                                                   # yet built). See CLAUDE.md's deferred-
                                                   # requirements table.
MODIFIER_STRENGTH_WEAK=5                          # OPTIONAL, default 5
MODIFIER_STRENGTH_MEDIUM=10                       # OPTIONAL, default 10
MODIFIER_STRENGTH_STRONG=15                       # OPTIONAL, default 15
MODIFIER_STRENGTH_CRITICAL=25                     # OPTIONAL, default 25
MODIFIER_MAX_TOTAL_PER_DIMENSION=30               # OPTIONAL, default 30

# ---------------------------------------------------------------------------
# Dedup — architecture §5
# ---------------------------------------------------------------------------
DEDUP_WINDOW_SECONDS=300                          # OPTIONAL, default 300
