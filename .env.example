# SOC-3s agent-service — configuration reference
#
# Copy to .env and fill in real values. Never commit .env — it holds live
# TheHive / iTop / Elasticsearch credentials.
#
# config.py loads every variable below at import time and raises immediately
# on any missing REQUIRED variable. Variables marked OPTIONAL have the
# documented default shown and may be omitted.

# ---------------------------------------------------------------------------
# LLM — exactly one single-shot call per alert, no tools, no multi-turn.
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://172.20.24.225:11434/v1        # REQUIRED
LLM_MODEL=foundation-sec-reasoning:latest         # REQUIRED
LLM_API_KEY=sk-no-auth                            # REQUIRED (Ollama ignores it)

# ---------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------
THEHIVE_URL=http://172.20.24.221:9000             # REQUIRED
THEHIVE_API_KEY=                                  # REQUIRED

ITOP_URL=http://172.20.24.220:8080                # REQUIRED
ITOP_USER=                                        # REQUIRED
ITOP_PWD=                                         # REQUIRED (iTop REST auth_pwd)

# The :9200 port is mandatory. The bare host redirects (302) to the SOC web UI.
ES_URL=https://172.20.24.58:9200                  # REQUIRED
ES_API_KEY=                                       # REQUIRED (sent as "Authorization: ApiKey <value>")

QDRANT_URL=http://172.20.24.224:6333              # REQUIRED
QDRANT_EMBEDDING_MODEL=BAAI/bge-m3                # OPTIONAL, default BAAI/bge-m3
# BAAI/bge-m3 above runs behind its own HTTP microservice, not in-process.
EMBEDDING_API_URL=http://172.20.24.224:8001       # REQUIRED

# Cortex is NOT configured and NOT called by this service. Analyzer reports
# arrive pre-computed on the TheHive alert.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
FP_TRACKING_DB_PATH=./data/fp_events.db           # OPTIONAL, default ./data/fp_events.db

# Redis is optional by design — absence disables dedup and NEVER blocks the
# pipeline. Not deployed in this environment.
# REDIS_URL=redis://localhost:6379                # OPTIONAL, no default

# ---------------------------------------------------------------------------
# Timeouts (seconds) — per-tool budgets for evidence gathering, and the
# single triage LLM call.
# ---------------------------------------------------------------------------
STAGE_1_TOOL_TIMEOUT_ITOP=5                       # OPTIONAL, default 5
STAGE_1_TOOL_TIMEOUT_THEHIVE=5                    # OPTIONAL, default 5
STAGE_1_TOOL_TIMEOUT_ES=3                         # OPTIONAL, default 3
STAGE_1_TOOL_TIMEOUT_QDRANT=3                     # OPTIONAL, default 3
STAGE_TRIAGE_LLM_TIMEOUT=600                      # OPTIONAL, default 600. Generous because
                                                   # CPU-bound inference on a full evidence
                                                   # dump can take several minutes; tighten
                                                   # this against a GPU-backed endpoint.
